@{
    Layout = "_Layout";
    ViewBag.Titulo = "Excluir Revista";
}

@model ExcluirRevistaViewModel

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="Excluir" method="post">
    <input asp-for="Id" type="hidden" />

    <div class="mb-3">
        <label class="form-label fw-semibold text-primary text-uppercase small">Título</label>
        <input value="@Model.Titulo" class="form-control" disabled>
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold text-primary text-uppercase small">Número da Edição</label>
        <input value="@Model.NumeroEdicao" class="form-control" disabled>
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold text-primary text-uppercase small">Ano de Publicação</label>
        <input value="@Model.AnoPublicacao.Year" class="form-control" disabled>
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold text-primary text-uppercase small">Caixa</label>
        <input value="@Model.CaixaId" class="form-control" disabled>
    </div>

    <div class="alert alert-warning" role="alert">
        Tem certeza de que deseja excluir esta revista? Esta ação não poderá ser desfeita.
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar">Cancelar</a>
        <button class="btn btn-danger rounded-pill px-4" type="submit">Excluir</button>
    </div>
</form>