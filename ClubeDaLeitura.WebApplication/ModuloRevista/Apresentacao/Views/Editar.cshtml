@model EditarRevistaViewModel

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Editar Revista";
}

<form id="formEditar" class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="Editar" method="post">
    <input asp-for="Id" type="hidden" />

    @if (ViewData.ModelState.Values.SelectMany(v => v.Errors).Any())
    {
        <div asp-validation-summary="All" class="alert alert-danger border-danger rounded-3 p-3 mb-4" role="alert"></div>
    }

    <div class="mb-3">
        <label asp-for="Titulo" class="form-label fw-semibold text-primary text-uppercase small">Título</label>
        <input asp-for="Titulo" type="text" class="form-control" placeholder="Ex: Revista Scientifica Vol. 42" />
        <span asp-validation-for="Titulo" class="text-danger small fw-semibold"></span>
    </div>

    <div class="mb-3">
        <label asp-for="NumeroEdicao" class="form-label fw-semibold text-primary text-uppercase small">Número da Edição</label>
        <input asp-for="NumeroEdicao" type="number" min="1" class="form-control" placeholder="Ex: 5" />
        <span asp-validation-for="NumeroEdicao" class="text-danger small fw-semibold"></span>
    </div>

    <div class="mb-3">
        <label asp-for="AnoPublicacao" class="form-label fw-semibold text-primary text-uppercase small">Ano de Publicação</label>
        <input asp-for="AnoPublicacao" type="date" class="form-control" />
        <span asp-validation-for="AnoPublicacao" class="text-danger small fw-semibold"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CaixaId" class="form-label fw-semibold text-primary text-uppercase small">Caixa</label>
        <select asp-for="CaixaId" class="form-select"
                asp-items="@(new SelectList(ViewBag.Caixas, "Id", "Etiqueta", Model.CaixaId))">
            @if (ViewBag.Caixas == null || !((IEnumerable<dynamic>)ViewBag.Caixas).Any())
            {
                <option disabled selected>Nenhuma caixa cadastrada disponível</option>
            }
        </select>
        <span asp-validation-for="CaixaId" class="text-danger small fw-semibold"></span>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-3">
        <a class="btn btn-outline-primary rounded-pill px-4 py-2" asp-action="Listar">Voltar</a>
        <button id="btnConfirmar" class="btn btn-primary rounded-pill px-4" type="submit" disabled>Confirmar</button>
    </div>
</form>

<script>
    const form = document.getElementById("formEditar");
    const btnConfirmar = document.getElementById("btnConfirmar");

    const valoresIniciais = {};
    [...form.elements].forEach(el => {
        if (el.name) valoresIniciais[el.name] = el.value;
    });

    form.addEventListener("input", () => {
        let mudou = false;
        [...form.elements].forEach(el => {
            if (el.name && valoresIniciais[el.name] !== el.value) {
                mudou = true;
            }
        });
        btnConfirmar.disabled = !mudou || !form.checkValidity();
    });
</script>
