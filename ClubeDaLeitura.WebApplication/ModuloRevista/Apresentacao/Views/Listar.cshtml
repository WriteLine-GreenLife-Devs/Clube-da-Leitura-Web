@model List<ListarRevistasViewModel>

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem de Revistas";
}

<a class="btn-cadastrar-novo" asp-action="Cadastrar">Cadastrar Novo</a>

@if (!Model.Any())
{
    <div class="alert alert-primary border-start border-primary border-2 rounded-3" role="alert">
        Nenhuma revista cadastrada.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="registros">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Título</th>
                    <th>Número da Edição</th>
                    <th>Ano de Publicação</th>
                    <th>Caixa</th>
                    <th>Status</th>
                    <th>Ações</th>
                </tr>
            </thead>
            
            <tbody>
                @foreach (ListarRevistasViewModel revista in Model)
                {
                    <tr>
                        <td data-label="ID">@revista.Id</td>
                        <td data-label="Título">@revista.Titulo</td>
                        <td data-label="Nº Edição">@revista.NumeroEdicao</td>
                        <td data-label="Ano Publ.">@revista.AnoPublicacao.Year</td>
                        <td data-label="Caixa">@revista.CaixaEtiqueta</td>
                        <td data-label="Status">@revista.Status</td>
                        <td data-label="Ações">
                            <div class="acoes-wrapper">
                                <a asp-action="Editar" asp-route-id="@revista.Id">Editar</a>
                                <a asp-action="Excluir" asp-route-id="@revista.Id">Excluir</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
