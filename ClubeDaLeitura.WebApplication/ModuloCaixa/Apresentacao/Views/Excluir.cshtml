@{
    Layout = "_Layout";
    ViewBag.Titulo = "Excluir Caixa";
}

@model ExcluirCaixaViewModel

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="Excluir" method="post">
    <input asp-for="Id" type="hidden" />

    <div class="mb-3">
        <label class="form-label fw-semibold text-primary text-uppercase small">Etiqueta</label>
        <input value="@Model.Etiqueta" class="form-control" disabled>
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold text-primary text-uppercase small">Cor</label>
        <input value="@Model.Cor" class="form-control" disabled>
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold text-primary text-uppercase small">Dias de Empréstimo</label>
        <input value="@Model.DiasDeEmprestimo" class="form-control" disabled>
    </div>

    <div class="alert alert-warning" role="alert">
        Tem certeza de que deseja excluir esta caixa? Esta ação não poderá ser desfeita.
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar">Cancelar</a>
        <button class="btn btn-danger rounded-pill px-4" type="submit">Excluir</button>
    </div>
</form>
