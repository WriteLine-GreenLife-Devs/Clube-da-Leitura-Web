@{
    Layout = "_Layout";
    ViewBag.Titulo = "Editar Caixa";
}

@model EditarCaixaViewModel

<form id="formEditar" class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="Editar" method="post">
    <input asp-for="Id" type="hidden" />

    @if (ViewData.ModelState.Values.SelectMany(v => v.Errors).Any())
    {
        <div asp-validation-summary="All" class="alert alert-danger border-danger rounded-3 p-3 mb-4" role="alert"></div>
    }

    <div class="mb-3">
        <label asp-for="Etiqueta" class="form-label fw-semibold text-primary text-uppercase small">Etiqueta <span class="text-muted"></span></label>
        <input asp-for="Etiqueta" type="text" class="form-control" placeholder="Ex: Terror">
        <span asp-validation-for="Etiqueta" class="text-danger small fw-semibold"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Cor" class="form-label fw-semibold text-primary text-uppercase small">Cor <span class="text-muted"></span></label>
        <input asp-for="Cor" type="text" class="form-control" placeholder="Ex: Azul">
        <span asp-validation-for="Cor" class="text-danger small fw-semibold"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DiasDeEmprestimo" class="form-label fw-semibold text-primary text-uppercase small">Dias de Empréstimo <span class="text-muted"></span></label>
        <input asp-for="DiasDeEmprestimo" type="number" min="1" class="form-control" placeholder="Ex: 7">
        <span asp-validation-for="DiasDeEmprestimo" class="text-danger small fw-semibold"></span>
    </div>

    <div class="form-buttons-group">
        <a class="btn btn-outline-primary rounded-pill px-4 py-2" asp-action="Listar">Voltar</a>
        <button id="btnConfirmar" class="btn btn-primary rounded-pill px-4" type="submit" disabled>Salvar Alterações</button>
    </div>
</form>

<script>
    const form = document.getElementById("formEditar");
    const btnConfirmar = document.getElementById("btnConfirmar");

    const valoresIniciais = {};
    [...form.elements].forEach(el => {
        if (el.name) valoresIniciais[el.name] = el.value;
    });

    form.addEventListener("input", () => {
        let mudou = false;
        [...form.elements].forEach(el => {
            if (el.name && valoresIniciais[el.name] !== el.value) {
                mudou = true;
            }
        });
        btnConfirmar.disabled = !mudou || !form.checkValidity();
    });
</script>

