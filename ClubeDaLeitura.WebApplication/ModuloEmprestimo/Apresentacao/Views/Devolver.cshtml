@model DevolverEmprestimoViewModel

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Registrar Devolução";
}

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="Devolver" method="post">
    <input asp-for="Id" type="hidden" />

    <div class="mb-3">
        <label class="form-label fw-semibold text-primary text-uppercase small">Amigo</label>
        <input value="@Model.AmigoNome" class="form-control" disabled>
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold text-primary text-uppercase small">Revista</label>
        <input value="@Model.RevistaTitulo" class="form-control" disabled>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label fw-semibold text-primary text-uppercase small">Data Empréstimo</label>
            <input value="@Model.DataEmprestimo.ToString("dd/MM/yyyy")" class="form-control" disabled>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold text-primary text-uppercase small">Data Prevista</label>
            <input value="@Model.DataDevolucaoPrevista.ToString("dd/MM/yyyy")" class="form-control" disabled>
        </div>
    </div>

    <div class="alert alert-info border-info border-2 rounded-3 p-3 mb-4" role="alert">
        A devolução será registrada com a data atual.
    </div>

    <div class="d-flex justify-content-end align-items-center gap-2 mt-4">
        <a class="btn btn-outline-primary rounded-pill px-4 py-2" asp-controller="Emprestimo" asp-action="Listar">Voltar</a>
        <button class="btn btn-primary rounded-pill px-4 py-2" type="submit">Confirmar Devolução</button>
    </div>
</form>

