@{
    Layout = "_Layout";
    ViewBag.Titulo = "Cadastro de Amigo";
}

@model CadastrarAmigoViewModel;

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="Cadastrar" method="post">

    @if (ViewData.ModelState.Values.SelectMany(v => v.Errors).Any())
    {
        <div asp-validation-summary="All" class="alert alert-danger border-danger rounded-3 p-3 mb-4" role="alert"></div>
    }

    <div class="mb-3">
        <label asp-for="Nome" class="form-label fw-semibold text-primary text-uppercase small">Nome <span class="text-muted"></span></label>
        <input asp-for="Nome" type="text" class="form-control" placeholder="Ex: João da Silva">
        <span asp-validation-for="Nome" class="text-danger small fw-semibold"></span>
    </div>

    <div class="mb-3">
        <label asp-for="NomeResponsavel" class="form-label fw-semibold text-primary text-uppercase small">Nome do Responsável <span class="text-muted"></span></label>
        <input asp-for="NomeResponsavel" type="text" class="form-control" placeholder="Ex: Maria da Silva">
        <span asp-validation-for="NomeResponsavel" class="text-danger small fw-semibold"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Telefone" class="form-label fw-semibold text-primary text-uppercase small">Telefone <span class="text-muted"></span></label>
        <input asp-for="Telefone" type="text" class="form-control" placeholder="Ex: (11) 9 9999-9999">
        <span asp-validation-for="Telefone" class="text-danger small fw-semibold"></span>
    </div>

    <div class="form-buttons-group">
        <a class="btn btn-outline-primary rounded-pill px-4 py-2" asp-action="Listar">Voltar</a>
        <button class="btn btn-primary rounded-pill px-4" type="submit">Confirmar</button>
    </div>
</form>

