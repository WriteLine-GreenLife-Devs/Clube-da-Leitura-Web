@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem de Amigos";
}

@model List<ListarAmigosViewModel>;


<a class="btn-cadastrar-novo" asp-action="Cadastrar">Cadastrar Novo</a>

@if (Model.Count == 0)
{
    <div class="alert alert-primary border-start border-primary border-2 rounded-3" role="alert">
        Nenhum amigo cadastrado.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="registros">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nome</th>
                    <th>Nome do Responsável</th>
                    <th>Telefone</th>
                    <th>Ações</th>
                </tr>
            </thead>

            <tbody>
                @foreach (ListarAmigosViewModel a in Model)
                {
                    <tr>
                        <td data-label="ID">@a.Id</td>
                        <td data-label="Nome">@a.Nome</td>
                        <td data-label="Responsável">@a.NomeResponsavel</td>
                        <td data-label="Telefone">@a.Telefone</td>
                        <td data-label="Ações">
                            <div class="acoes-wrapper">
                                <a asp-action="Editar" asp-route-id="@a.Id">Editar</a>
                                <a asp-controller="Emprestimo" asp-action="Listar" asp-route-amigoId="@a.Id">Empréstimos</a>
                                <a asp-action="Excluir" asp-route-id="@a.Id">Excluir</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

